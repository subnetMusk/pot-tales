################################################################################
# Environment Configuration
# 
# This file contains all environment variables for the Docker Compose stack.
# It centralizes configuration for all services including backend, frontend,
# databases, monitoring, and ELK stack components.
################################################################################

################################################################################
# BACKEND API SERVICE (Go)
################################################################################

# HTTP port for the Go backend service
PORT=3000

# MongoDB connection string for the main application database
MONGO_URI=mongodb://db:27017/database

# Secret key used for JWT token generation and validation
JWT_SECRET=secret-key123

# Session timeout duration in minutes for user sessions
SESSION_TTL_MIN=30

# Directory path for JSON Schema files used for server request validation
SCHEMA_DIR_SERVER=/src/comms/server

################################################################################
# REDIS CONFIGURATION
################################################################################

# Redis user credentials for backend service (full access permissions)
REDIS_APP_PASS=app-password
REDIS_URL=redis://app:${REDIS_APP_PASS}@redis:6379/0

# Redis user credentials for frontend service (read-only permissions)
REDIS_FE_PASS=fe-password
REDIS_FE_URL=redis://frontend:${REDIS_FE_PASS}@redis:6379/0

# Redis Commander UI configuration for database administration
REDIS_UI_HOSTS=local:redis:6379:0:redisui:redisuipass

################################################################################
# FRONTEND SERVICES
################################################################################

# Node.js environment for build optimization (development/production)
NODE_ENV=development

# Backend API URL for frontend service communication
VITE_API_SERVER=http://server:3000

# Vite development server port for hot reload functionality
VITE_PORT=5173

################################################################################
# REVERSE PROXY (NGINX Proxy Manager)
################################################################################

# Admin UI port for NGINX Proxy Manager web interface
PROXY_ADMIN_PORT=18081

# SQLite database file path for proxy configuration storage
DB_SQLITE_FILE=/data/database.sqlite

################################################################################
# DATABASE SERVICES
################################################################################

# MongoDB container hostname for service discovery
MONGODB_HOST=db

# MongoDB Express web UI port for database administration
MONGO_EXPRESS_PORT=8081

# Redis Commander web UI port for cache administration  
REDIS_UI_PORT=8081

################################################################################
# ELASTICSEARCH CLUSTER
################################################################################

# Elasticsearch HTTP endpoint for client connections
ELASTICSEARCH_HOST=http://elasticsearch:9200

# Elasticsearch hosts array format for Kibana configuration
ELASTICSEARCH_HOSTS=http://elasticsearch:9200

# Single-node discovery mode for development deployment
ELASTICSEARCH_DISCOVERY_TYPE=single-node

# Enable X-Pack security features for authentication
ELASTICSEARCH_SECURITY_ENABLED=true

# Enable API key authentication method
ELASTICSEARCH_API_KEY_ENABLED=true

# JVM heap size configuration for Elasticsearch performance
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

################################################################################
# ELASTICSEARCH SECURITY ACCOUNTS
################################################################################

# Built-in elastic superuser account for cluster administration
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=m6OHmMuiqNrV1i25Jz3Z

# System account for Kibana to Elasticsearch communication
KIBANA_SYSTEM_USERNAME=kibana_system  
KIBANA_SYSTEM_PASSWORD=eJL-r*4rNjRioOwWPEMT

# Custom admin account for Kibana web interface access
KIBANA_UI_USERNAME=kibana_admin
KIBANA_UI_PASSWORD=changeme123

# Dedicated account for APM Server data ingestion
APM_USERNAME=apm_writer
APM_PASSWORD=apm123pass

################################################################################
# KIBANA ANALYTICS PLATFORM
################################################################################

# Kibana web interface port for dashboard access
KIBANA_PORT=5601

# External Kibana URL for browser access via proxy
KIBANA_URL=http://kibana.localhost

# Kibana internal service URL for inter-service communication
KIBANA_HOST=http://kibana:5601

# Default index pattern for log data visualization
KIBANA_INDEX_PATTERN=logs-*

################################################################################
# APM (Application Performance Monitoring)
################################################################################

# APM Server listening port for agent data ingestion
APM_SERVER_PORT=8200

# Secret token for APM agent authentication and authorization
APM_SECRET_TOKEN=apm-secret-token-123

# External APM Server URL for agent configuration (via proxy)
APM_SERVER_URL=http://apm.localhost

# Internal APM Server URL for container-to-container communication
APM_SERVER_INTERNAL_URL=http://apm-server:${APM_SERVER_PORT}

# Kibana URL for APM Server integration and setup
APM_KIBANA_HOST=http://kibana:${KIBANA_PORT}

################################################################################
# APPLICATION APM CONFIGURATION
################################################################################

# APM Server endpoint for Go backend service instrumentation
ELASTIC_APM_SERVER_URL=http://apm.localhost

# Service name identifier for APM traces and metrics
ELASTIC_APM_SERVICE_NAME=go-backend

# Environment label for APM data categorization
ELASTIC_APM_ENVIRONMENT=development

# APM Secret token for Go backend authentication
ELASTIC_APM_SECRET_TOKEN=${APM_SECRET_TOKEN}

################################################################################
# RUM (Real User Monitoring) CONFIGURATION
################################################################################

# RUM Server URL for frontend JavaScript agent
ELASTIC_APM_RUM_SERVER_URL=http://apm.localhost

# RUM Service name for frontend application
ELASTIC_APM_RUM_SERVICE_NAME=frontend-app

# RUM Secret token for frontend authentication (different from backend)
ELASTIC_APM_RUM_SECRET_TOKEN=rum-secret-token-456

################################################################################
# ELASTIC AGENT & FLEET
################################################################################

# Enable standalone mode for Elastic Agent (no Fleet Server required)
ELASTIC_AGENT_STANDALONE=true
ES_USERNAME=elastic_agent
ES_PASSWORD=m6OHmMuiqNrV1i25Jz3Z

# Fleet enrollment token for agent registration (if using Fleet mode)
FLEET_ENROLLMENT_TOKEN=456ed72a-c343-4786-996e-482f577759ba
