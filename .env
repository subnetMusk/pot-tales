###########################################################################
# .env
###########################################################################

########################
# Core back-end (Go API)
########################
PORT=3000                                # porta HTTP del servizio Go
MONGO_URI=mongodb://db:27017/database    # connessione MongoDB
JWT_SECRET=secret-key123                 # usato per future JWT
SESSION_TTL_MIN=30                       # durata sessione (minuti)
SCHEMA_DIR_SERVER=/src/comms/server      # percorso dei file JSON Schema per validazione richieste a server

# Redis – utente “app” (pieno accesso, usato dal server Go)
REDIS_APP_PASS=app-password
REDIS_URL=redis://app:${REDIS_APP_PASS}@redis:6379/0

########################
# Front-end container
########################
NODE_ENV=development                     # per build React/Vite
VITE_API_SERVER=http://server:3000       # URL del back-end
VITE_PORT=5173                           # porta Vite dev server

# Redis – utente “frontend” (sola lettura, usato dal front-end server)
REDIS_FE_PASS=fe-password
REDIS_FE_URL=redis://frontend:${REDIS_FE_PASS}@redis:6379/0