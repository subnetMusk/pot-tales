# Node
node_modules/
npm-debug.log*
yarn-error.log

# Build
dist/
build/
temp/

# Go
server/tmp/
server/server
*.test

# Editor
.vscode/
.idea/
*.swp

# Logs
*.log

# OS / Misc
.DS_Store
Thumbs.db
.MACOSX
# non cancellatela pls
Icon?

# Docker
*.pid

# ---- Segreti / config locale (NON committare) ----
# I .env restano volutamente versionati come esempio condiviso del team,
# ma i backup automatici contengono segreti vecchi: mai tracciarli.
backups/

# ---- Certificati ----
proxy/certs/*.pem
!proxy/certs/.gitkeep

# ---- Dati runtime dei volumi Docker (mai versionare) ----
# MongoDB
docker/volumes/mongodb/*
!docker/volumes/mongodb/.gitkeep
# Elasticsearch / log shipper data
docker/volumes/logs/*
!docker/volumes/logs/.gitkeep
docker/volumes/esdata/
# Kibana runtime (uuid, sessioni, saved objects su disco)
docker/volumes/kibana/data/
# Fleet server data
docker/volumes/fleetserverdata/
# NGINX Proxy Manager: SQLite, chiavi, log e vhost generati a runtime
docker/volumes/npm_data/*
!docker/volumes/npm_data/.gitkeep
docker/volumes/npm_letsencrypt/*
!docker/volumes/npm_letsencrypt/.gitkeep
