# Node
node_modules/
npm-debug.log*
yarn-error.log

# Build
dist/
build/
temp/

# Go
server/tmp/
server/server
*.test

# Editor
.vscode/
.idea/
*.swp

# Logs
*.log

# OS / Misc
.DS_Store
Thumbs.db
.MACOSX
# non cancellatela pls
Icon?

# Docker
*.pid

# ---- Segreti / config locale (NON committare) ----
# .env in chiaro: mai committarli. I file SOPS cifrati (*.enc.env) invece
# SONO versionati: e' proprio lo scopo del flusso SOPS+age.
.env
!.env.example
secrets/*.env
!secrets/*.enc.env
backups/

# ---- Certificati ----
proxy/certs/*.pem
!proxy/certs/.gitkeep

# ---- Dati runtime dei volumi Docker (mai versionare) ----
# MongoDB
docker/volumes/mongodb/*
!docker/volumes/mongodb/.gitkeep
# Elasticsearch / log shipper data
docker/volumes/logs/*
!docker/volumes/logs/.gitkeep
docker/volumes/esdata/
# Kibana runtime (uuid, sessioni, saved objects su disco)
docker/volumes/kibana/data/
# Fleet server data
docker/volumes/fleetserverdata/

# Token Fleet generati da scripts/fleet-bootstrap.sh
.env.fleet*
