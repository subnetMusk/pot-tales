{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateSessionRequest",
  "type": "object",
  "properties": {
    "device": {
      "type": "string",
      "maxLength": 64
    },
    "ipAddress": {
      "type": "string",
      "format": "ipv4"
    },
    "consentGiven": {
      "type": "boolean",
      "description": "True if the user has given consent to store session data."
    }
  },
  "required": ["consentGiven"],
  "additionalProperties": false
}