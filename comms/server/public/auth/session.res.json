{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateSessionResponse",
  "type": "object",
  "properties": {
    "token":   {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "expires": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["token", "expires"],
  "additionalProperties": false
}
