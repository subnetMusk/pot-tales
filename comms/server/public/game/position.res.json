{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetPositionResponse",
  "type": "object",
  "properties": {
    "scene_id": {
      "type": "string"
    },
    "x": {
      "type": "string",
      "pattern": "^[-+]?(\\d+(\\.\\d*)?|\\.\\d+)$"
    },
    "y": {
      "type": "string",
      "pattern": "^[-+]?(\\d+(\\.\\d*)?|\\.\\d+)$"
    },
    "last_ping": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["scene_id","x", "y", "last_ping"],
  "additionalProperties": false
}