{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoadPositionResponse",
  "type": "object",
  "properties": {
    "x": {
      "type": "number",
      "description": "Coordinata x del giocatore"
    },
    "y": {
      "type": "number",
      "description": "Coordinata y del giocatore"
    },
    "battery": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentuale di batteria"
    }
  },
  "required": ["x", "y", "battery"],
  "additionalProperties": false
}