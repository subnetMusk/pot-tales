{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SaveStateRequest",
  "type": "object",
  "properties": {
    "state": {
      "type": "object",
      "description": "Stato del giocatore, attualmente solo le coordinate",
      "properties": {
        "cookie": {
          "type": "string",
          "description": "ID della sessione del giocatore"
          },
        "x": {
          "type": "number",
          "description": "Coordinate X del giocatore sulla mappa",
          "minimum": 0
          },
        "y": {
          "type": "number",
          "description": "Coordinate Y del giocatore sulla mappa",
          "minimum": 0
          },
        "level": {
          "type": "number",
          "description": "Livello attuale del giocatore"
          },
        "battery": {
          "type": "number",
          "description": "Livello di batteria della torcia",
          "minimum": 0,
          "maximum": 100
          },
        "inventory": {
          "type": "array",
          "description": "Inventario"
        }
      }
    }
  },
  "required": ["state"],
  "additionalProperties": false
}