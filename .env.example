################################################################################
# Environment Configuration Example
#
# Copy to .env for local development. Do not commit .env.
# Production/staging secrets should be stored in an encrypted SOPS file.
################################################################################

################################################################################
# BACKEND API SERVICE (Go)
################################################################################

PORT=3000
MONGO_URI=mongodb://db:27017/database
JWT_SECRET=change-me-generate-a-long-random-value
SESSION_TTL_MIN=30
SCHEMA_DIR_SERVER=/src/comms/server

################################################################################
# REDIS CONFIGURATION
################################################################################

REDIS_APP_PASS=change-me
REDIS_URL=redis://app:${REDIS_APP_PASS}@redis:6379/0
REDIS_FE_PASS=change-me
REDIS_FE_URL=redis://frontend:${REDIS_FE_PASS}@redis:6379/0
REDIS_UI_HOSTS=local:redis:6379:0:redisui:change-me

################################################################################
# FRONTEND SERVICES
################################################################################

NODE_ENV=development
VITE_API_SERVER=http://server:3000
VITE_PORT=5173

# Optional private registry credentials. Leave empty unless needed.
NPM_EMAIL=
NPM_PASSWORD=

################################################################################
# REVERSE PROXY (Traefik)
################################################################################

TRAEFIK_DASHBOARD_PORT=8080

################################################################################
# DATABASE SERVICES
################################################################################

MONGODB_HOST=db
MONGO_EXPRESS_PORT=8081
REDIS_UI_PORT=8082

################################################################################
# ELASTICSEARCH CLUSTER
################################################################################

STACK_VERSION=8.11.0
CLUSTER_NAME=docker-cluster
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_HOSTS=https://es01:9200
ELASTICSEARCH_DISCOVERY_TYPE=single-node
ELASTICSEARCH_SECURITY_ENABLED=true
ELASTICSEARCH_API_KEY_ENABLED=true
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
ES_MEM_LIMIT=1073741824

################################################################################
# ELASTICSEARCH SECURITY ACCOUNTS
################################################################################

ELASTIC_PASSWORD=change-me
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=${ELASTIC_PASSWORD}
KIBANA_PASSWORD=change-me
KIBANA_SYSTEM_USERNAME=kibana_system
KIBANA_SYSTEM_PASSWORD=${KIBANA_PASSWORD}
KIBANA_UI_USERNAME=kibana_admin
KIBANA_UI_PASSWORD=change-me
APM_USERNAME=apm_writer
APM_PASSWORD=change-me

################################################################################
# KIBANA ANALYTICS PLATFORM
################################################################################

KIBANA_PORT=5601
KIBANA_URL=http://kibana.localhost
KIBANA_HOST=http://kibana:5601
KIBANA_INDEX_PATTERN=logs-*
KIBANA_ENCRYPTION_KEY=change-me-64-hex-characters-minimum-for-production
KIBANA_MEM_LIMIT=1073741824

################################################################################
# APM (Application Performance Monitoring)
################################################################################

APM_SERVER_PORT=8200
APM_SECRET_TOKEN=change-me
APM_SERVER_URL=http://apm.localhost
APM_SERVER_INTERNAL_URL=http://apm-server:${APM_SERVER_PORT}
APM_KIBANA_HOST=http://kibana:${KIBANA_PORT}

################################################################################
# APPLICATION APM CONFIGURATION
################################################################################

ELASTIC_APM_SERVER_URL=http://apm.localhost
ELASTIC_APM_SERVICE_NAME=go-backend
ELASTIC_APM_ENVIRONMENT=development
ELASTIC_APM_SECRET_TOKEN=${APM_SECRET_TOKEN}

################################################################################
# RUM (Real User Monitoring) CONFIGURATION
################################################################################

ELASTIC_APM_RUM_SERVER_URL=http://apm.localhost
ELASTIC_APM_RUM_SERVICE_NAME=frontend-app
ELASTIC_APM_RUM_ACTIVE=false

################################################################################
# ELASTIC AGENT & FLEET
################################################################################

# Agents are Fleet-managed. Standalone elastic-agent.yml is intentionally absent.
FLEET_ENROLLMENT_TOKEN=change-me-after-kibana-fleet-setup
FLEET_ENROLLMENT_TOKEN_APM=${FLEET_ENROLLMENT_TOKEN}
FLEET_ENROLLMENT_TOKEN_INFRA=${FLEET_ENROLLMENT_TOKEN}
