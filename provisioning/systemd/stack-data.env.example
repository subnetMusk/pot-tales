# Modello per /etc/stack-data.env
#
# Parametri di esportazione, copia di sicurezza e ripristino.
#
#   sudo install -m 0600 -o root -g root \
#        stack-data.env.example /etc/stack-data.env
#
# Il file compilato non va versionato.
#
# Le credenziali del cluster e la chiave di ping del servizio di sorveglianza
# **non** stanno qui: vivono in /etc/stack-surveillance.env, che data-backup.sh
# legge in aggiunta a questo file. Duplicarle esporrebbe al caso in cui una
# rotazione ne aggiorna una copia e dimentica l'altra.

# --- Destinazioni -------------------------------------------------------------

# Directory nota in cui finiscono gli archivi di esportazione. Servirli e'
# compito del bordo: nulla in questa configurazione apre un percorso di rete.
EXPORT_DEST=/srv/export

# Esportazioni conservate. Il disco che le ospita e' lo stesso che serve agli
# indici, e riempirlo porta Elasticsearch in sola lettura al 95%.
EXPORT_KEEP=5

# Archivi portabili della copia notturna, e copie di sicurezza dello stato
# preso da parte prima di un ripristino.
BACKUP_DEST=/srv/backup
DUMP_KEEP=7
SAFEGUARD_DEST=/srv/backup/sicurezza

# --- Elasticsearch ------------------------------------------------------------

# Rete a cui si collega il contenitore che esegue lo scorrimento. La rete di
# osservabilita' e' dichiarata attachable proprio per consentirlo.
ES_NET=pi_elastic
ES_URL=https://es01:9200
ES_USER=elastic

# Password letta da file: non compare fra le variabili d'ambiente del
# contenitore, che `docker inspect` mostra a chiunque possa interrogare il
# demone. In alternativa ES_PASSWORD, che non ha questa proprieta'.
ES_PASSWORD_FILE=/srv/progetti_innovativi/secrets/elastic_password
ES_CA=/srv/docker/volumes/certs/_data/ca/ca.crt

# Modelli di indice da esportare, separati da virgola. Un modello che non
# corrisponde a nulla viene ignorato: gli indici giornalieri esistono solo dopo
# il primo documento.
ES_INDICI=logs-*,metrics-*,traces-*,alerts-*

# --- MongoDB ------------------------------------------------------------------

# Filtro sul nome del contenitore che esegue mongod. Lo scorrimento avviene per
# exec e non per rete: la rete di persistenza e' dichiarata internal e non
# attachable, quindi un contenitore esterno allo stack non puo' collegarvisi.
MONGO_CONTAINER=pi_db
MONGO_VOLUME=pi_mongodata
MONGO_DB=game_db
MONGO_USER=root

# Percorso **interno al contenitore di MongoDB**: la password non transita
# dall'host e non compare fra gli argomenti di docker.
MONGO_PASSWORD_FILE=/run/secrets/mongo_root_password

# --- Freno --------------------------------------------------------------------

# Documenti per richiesta e pausa fra un lotto e il successivo. La cadenza dei
# lotti e' la sola leva che riduce davvero il carico su Elasticsearch: il lavoro
# pesante lo fa il cluster leggendo i segmenti, non il client.
#
# Alzare LOTTO accelera l'esportazione e la rende piu' invasiva; alzare PAUSA
# fa il contrario. I valori qui sotto sono tarati per poter esportare durante
# un'apertura al pubblico.
LOTTO=1000
PAUSA=0.2

# Limiti sul contenitore che esegue lo scorrimento. Governano il client, non il
# cluster: servono a impedire che il processo di esportazione diventi esso
# stesso il problema.
CPU_QUOTA=0.5
MEM_LIMIT=256m

# --- Snapshot LVM -------------------------------------------------------------

# Volume group e volume logico che ospita i dati Docker, creati da
# bin/setup-volumes.sh.
VG_NAME=ubuntu-vg
LV_DOCKER=docker

# Spazio copy-on-write dello snapshot: deve bastare a contenere le scritture
# che avvengono mentre lo snapshot esiste. Uno snapshot che lo esaurisce viene
# invalidato dal kernel, resta elencato e non e' piu' ripristinabile.
#
# Richiede spazio **non allocato** nel volume group: se setup-volumes.sh ha
# assegnato tutto lo spazio ai volumi, lo snapshot non e' creabile.
SNAP_SIZE=8G
SNAP_KEEP=3
