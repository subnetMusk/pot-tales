# Modello per /etc/stack-deploy.env
#
#   sudo install -m 0600 -o root -g root \
#        stack-deploy.env.example /etc/stack-deploy.env
#
# Non contiene credenziali, ma governa cosa viene messo in produzione: va
# trattato con la stessa cura.
#
# E' letto sia da systemd (EnvironmentFile) sia da bash con `.`: un valore che
# contiene spazi, come ES_JAVA_OPTS se impostata, va tra virgolette doppie.
# Senza, bash esegue come comando la parte dopo il primo spazio e non assegna la
# variabile.

# Posizione del repository sulla macchina.
STACK_DIR=/srv/progetti_innovativi/deploy
STACK_NAME=pi

# File JSON root-only prodotto da configure-dashboard-users.py. Contiene le
# password in chiaro perche' Terraform deve creare le stesse utenze presenti
# negli htpasswd; non va versionato ne' distribuito con gli export.
DASHBOARD_USERS_TFVARS=/srv/progetti_innovativi/secrets/dashboard_users.tfvars.json

# Hostname pubblico. Deve corrispondere al nome per cui viene emesso il
# certificato, altrimenti la verifica del dominio fallisce.
APP_HOST=

# Recapito comunicato all'autorita' di certificazione, usato per gli avvisi di
# scadenza.
ACME_EMAIL=

# Directory dell'autorita' di certificazione. Vuota significa produzione.
#
# Tutto il collaudo va condotto contro la directory di prova: l'autorita' di
# produzione limita per settimana i certificati con lo stesso insieme di nomi, e
# pochi tentativi con configurazione sbagliata lasciano il dominio senza
# certificato valido fino allo scorrimento della finestra. Il certificato emesso
# in prova non e' attendibile e il browser lo segnala: e' il comportamento
# atteso, non un difetto da correggere.
#
# Passando da prova a produzione va rimosso il file di stato dal volume `acme`,
# altrimenti il certificato gia' ottenuto resta in cache e continua a essere
# servito.
#
#   prova: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=

# Durata dichiarata di HSTS, in secondi. Vuota o zero significa HSTS assente.
#
# Va lasciata a zero per tutto il collaudo e alzata solo dopo aver verificato la
# catena del certificato dall'esterno, da una rete che non sia quella di
# sviluppo. Il motivo e' che l'intestazione non e' revocabile: una volta
# ricevuta, il browser rifiuta di far proseguire su un avviso di certificato per
# tutta la durata dichiarata, e nessuna correzione lato server la accorcia per
# chi l'ha gia' ricevuta.
#
# Su un esercizio di poche settimane un anno non porta alcun beneficio e
# sopravvive alla dismissione della macchina. Un giorno da' la stessa protezione
# contro il downgrade e lascia una via d'uscita.
#
#   collaudo: 0        esercizio: 86400
HSTS_MAX_AGE=0

# Estensione di HSTS ai sottodomini. Da tenere disattivata finche' la
# configurazione non e' definitiva: con l'estensione attiva un sottodominio di
# prova con certificato non attendibile eredita il blocco.
HSTS_INCLUDE_SUBDOMAINS=false

# Immagini riferite per digest, nella forma nome@sha256:...
#
# Il tag e' mutabile: lo stesso comando eseguito a distanza di tempo porterebbe
# in servizio contenuto diverso senza che nulla lo segnali. Il digest e' scritto
# dalla pipeline nel riepilogo di esecuzione.
SERVER_IMAGE=
FRONTEND_IMAGE=
LANDING_IMAGE=

# Directory degli indici di Elasticsearch, montata dal volume `esdata01`. Deve
# esistere e appartenere a uid 1000 e gid 0, l'utente con cui gira l'immagine:
# lo script lo verifica prima del deploy. Vedi provisioning/README.md, Layout.
ES_DATA_DIR=/srv/data/elastic

# Indirizzo annunciato quando lo script inizializza lo swarm, cosa che fa solo
# se sul nodo non ne esiste ancora uno. Va indicato soltanto se la macchina ha
# piu' indirizzi: con uno solo il demone lo sceglie da se'.
SWARM_ADVERTISE_ADDR=

# Central API di CrowdSec: riceve la blocklist comunitaria e invia i segnali
# rilevati localmente. Comporta traffico verso un servizio esterno.
CROWDSEC_DISABLE_ONLINE_API=false

# --- Facoltative --------------------------------------------------------------
#
# Lette da stack.yml o dallo script con i valori predefiniti indicati: vanno
# impostate solo per discostarsene. Tolto il commento, valgono per stack e
# script allo stesso modo.

# Directory degli archivi servita in sola lettura su /export. Deve coincidere
# con EXPORT_DEST di /etc/stack-data.env, dove data-export.sh li scrive:
# altrimenti il bordo serve una directory e gli archivi finiscono in un'altra.
#EXPORT_DEST=/srv/export

# Rifiuto degli handshake per nomi senza certificato. Si disattiva solo per
# verifiche locali prima di un'emissione.
#TRAEFIK_SNI_STRICT=true

# Reti da cui il backend accetta X-Forwarded-For: quella interna di Swarm.
#TRUSTED_PROXY_CIDRS=10.0.0.0/8

# Sessioni: durata, chiusura per inattivita', finestra della quota e cadenza
# della spazzata che chiude le partite ferme.
#SESSION_TTL_MIN=30
#SESSION_IDLE_CLOSE_MIN=5
#SESSION_QUOTA_WINDOW_MIN=10
#SESSION_SWEEP_SEC=60

# Giorni di conservazione dei dati applicativi.
#DATA_RETENTION_DAYS=30

# Elasticsearch: heap (tra virgolette doppie, contiene spazi) e nome del cluster.
#ES_JAVA_OPTS="-Xms4g -Xmx4g"
#ES_CLUSTER_NAME=progetti-innovativi

# APM del backend.
#ELASTIC_APM_SERVER_URL=https://apm-agent:8200
#ELASTIC_APM_SERVICE_NAME=go-backend

# Base dati e utenza amministrativa di MongoDB. Devono coincidere con MONGO_DB
# e MONGO_USER di /etc/stack-data.env, usati da copia, export e ripristino.
#MONGO_DB_NAME=game_db
#MONGO_ROOT_USERNAME=root
