# Modello per /etc/stack-surveillance.env
#
# Configurazione condivisa dal battito e dal recapito degli allarmi. I due
# processi usano lo stesso servizio e le stesse credenziali del cluster: un file
# unico evita che una rotazione ne aggiorni uno e dimentichi l'altro.
#
#   sudo install -m 0600 -o root -g root \
#        stack-surveillance.env.example /etc/stack-surveillance.env
#
# Il file compilato non va versionato.
#
# E' letto sia da systemd (EnvironmentFile) sia da bash con `.`: un valore che
# contiene spazi va tra virgolette doppie. Senza, bash esegue come comando la
# parte dopo il primo spazio e non assegna la variabile.

# Chiave di ping del progetto sul servizio di sorveglianza. Gli endpoint si
# costruiscono come <base>/<chiave>/<slug del check>, quindi una chiave sola
# raggiunge tutti i check: e' l'equivalente di tutte le URL di ping messe
# insieme, e va trattata come tale. Chi la possiede puo' inviare battiti falsi,
# e un battito falso tiene spenta la sorveglianza mentre il servizio e' fermo.
HC_BASE=https://hc-ping.com
HC_PING_KEY=

# Controllo di vitalita', eseguito prima di inviare il battito. La richiesta va
# a https://<APP_HOST>/health attraverso il proxy, come quella di un visitatore,
# e la risposta riporta lo stato delle dipendenze: un valore falso qualsiasi
# blocca il ping.
#
# APP_HOST non si ripete qui: il battito lo legge da /etc/stack-deploy.env, lo
# stesso valore da cui i router prendono la regola Host. La connessione e'
# diretta a HEALTH_CONNECT mantenendo il nome pubblico, quindi non dipende dal
# DNS. Il certificato non viene verificato, perche' la sua validita' ha il
# controllo proprio (TLS_HOST, sotto).
HEALTH_CONNECT=127.0.0.1

# Cluster di osservabilita'. Interrogato sia per lo stato del cluster sia per
# leggere l'indice degli allarmi.
#
# Sullo stack in servizio Elasticsearch non pubblica alcuna porta: il proxy e'
# l'unico servizio che lo fa. L'indirizzo e' quindi il nome del servizio sulla
# rete di osservabilita', e ES_NETWORK dice da quale rete raggiungerlo. Con
# ES_NETWORK vuota si usa curl dell'host, che vale in sviluppo con Compose dove
# le porte sono pubblicate: in quel caso ES_URL torna a https://localhost:9200.
#
# Lasciare ES_NETWORK vuota su una macchina in servizio non produce un errore
# evidente: il cluster risulta irraggiungibile a ogni esecuzione, e l'allarme
# permanente che ne segue nasconde quelli veri.
ES_NETWORK=pi_elastic
# Task persistente da cui i timer interrogano la rete interna.
STACK_NAME=pi
ES_CURL_SERVICE=pi_surveillance-client
ES_URL=https://es01:9200
ES_USER=elastic
ES_PASSWORD=

# CA del cluster, nel volume `certs` dello stack. Docker antepone al nome il
# nome dello stack (`pi`) e lo tiene sotto la propria directory dati
# (`/srv/docker`): con un altro STACK_NAME o un'altra `data-root` il percorso
# cambia di conseguenza. Un percorso sbagliato non da' errore evidente: il
# cluster risulta irraggiungibile e l'allarme resta acceso in permanenza.
ES_CA=/srv/docker/volumes/pi_certs/_data/ca/ca.crt

# Indice di destinazione del connettore, definito in terraform/elk/alerting.tf.
ALERT_INDEX=alerts-infra

# Check su cui il recapito degli allarmi dichiara di essere vivo.
#
# I quattro check che alimenta sono relay con periodo di un anno: non scendono
# da soli, quindi se il processo si ferma il silenzio e' identico alla salute.
# Va configurato come battito, con periodo di circa dieci minuti e grazia di
# venti: il timer gira ogni due minuti, e una tolleranza piu' stretta
# trasformerebbe una singola esecuzione saltata in un allarme.
SELF_CHECK=alert-relay

# Nome pubblico su cui verificare il certificato. Vuoto disattiva il controllo,
# che e' lo stato corretto finche' il nome non esiste.
#
# La connessione viene diretta a TLS_CONNECT mantenendo TLS_HOST nella SNI e
# nella verifica: si controlla cosi' il certificato che il proxy presenta per
# quel nome, senza dipendere da come il nome risolve sulla macchina stessa ne'
# dal ritorno verso il proprio indirizzo pubblico.
#
# Il controllo NON dice che il servizio e' raggiungibile da internet: quello
# richiede una sonda esterna, che questo servizio di sorveglianza non esegue.
TLS_HOST=
TLS_CONNECT=127.0.0.1

# Giorni di validita' residua sotto i quali il certificato viene segnalato.
# Un'emissione tardiva puo' a sua volta fallire, quindi il margine deve bastare
# a tentarla piu' di una volta.
TLS_MIN_DAYS=10

# Marcatori di stato. Su un filesystem persistente, altrimenti ogni riavvio
# ripropone gli allarmi gia' visti e riporta i relay allo stato iniziale.
STATE_DIR=/var/lib/stack-surveillance

# Soglie locali sulle risorse dell'host. Il disco si ferma prima del watermark
# di Elasticsearch, che al 95% impone agli indici il blocco in sola lettura.
MEM_MIN_PCT=15
SWAP_MAX_PCT=50
DISK_MAX_PCT=85

# Punti di mount sorvegliati, uno per volume: quello degli indici e' il primo a
# riempirsi. I percorsi assenti vengono saltati. Tra virgolette, perche'
# contiene spazi: vedi l'intestazione.
DISK_MOUNTS="/ /var /srv/docker /srv/data/elastic /srv/backup /srv/export"

# Secondi concessi a ogni singola interrogazione. Deve restare ben sotto la
# cadenza dei timer, altrimenti due esecuzioni si sovrappongono.
TIMEOUT=10
