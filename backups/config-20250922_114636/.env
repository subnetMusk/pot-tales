################################################################################
# Environment Configuration
# 
# This file contains all environment variables for the Docker Compose stack.
# It centralizes configuration for all services including backend, frontend,
# databases, monitoring, and ELK stack components.
################################################################################

################################################################################
# BACKEND API SERVICE (Go)
################################################################################
# HTTP port for the Go backend service
PORT=3000
# MongoDB connection string for the main application database
MONGO_URI=mongodb://db:27017/database
# Secret key used for JWT token generation and validation
JWT_SECRET=secret-key123
# Session timeout duration in minutes for user sessions
SESSION_TTL_MIN=30
# Directory path for JSON Schema files used for server request validation
SCHEMA_DIR_SERVER=/src/comms/server

################################################################################
# REDIS
################################################################################
# Redis user credential and connection details for backend full access permissions
REDIS_APP_PASS=app-password
REDIS_URL=redis://app:${REDIS_APP_PASS}@redis:6379/0
# Redis credentials and connection details for frontend service (read-only permissions)
REDIS_FE_PASS=fe-password
REDIS_FE_URL=redis://frontend:${REDIS_FE_PASS}@redis:6379/0
# Redis Commander UI configuration for database administration
REDIS_UI_HOSTS=local:redis:6379:0:redisui:redisuipa

################################################################################
# FRONTEND
################################################################################
# Node.js enviroment for build optimization (development or production)
NODE_ENV=development
# Backend API URL for frontend to connect to
VITE_API_SERVER=http://server:3000
# Vite development server port for hot-reloading during development
VITE_PORT=5173
#Npm Registry authentication credentials for private packages
NPM_EMAIL=dev.progettiinnovativi.2025@gmail.com
NPM_PASSWORD=MmkjJTaz@GTn8p

################################################################################
# NGINX PROXY MANAGER
################################################################################
# Admin UI port fot NGINX Proxy Manager web interface 
PROXY_ADMIN_PORT=18081
# NGINX Proxy Manager database file path for proxy configuration storage
DB_SQLITE_FILE=/data/database.sqlite

################################################################################
# DATABASE 
################################################################################
# MongoDB container hostname for database service
MONGODB_HOST=db
#MongoDb Express web UI port for database administration
MONGO_EXPRESS_PORT=8081
# Redis Commander web UI port for cache administration
REDIS_UI_PORT=8081

################################################################################
# ELASTICSEARCH / KIBANA – VERSIONING & CLUSTER
################################################################################
STACK_VERSION=8.13.4         # versione usata dalle immagini ES/Kibana nella compose
CLUSTER_NAME=elk-cluster
LICENSE=basic

################################################################################
# ELASTICSEARCH – ENDPOINT & MODALITÀ
################################################################################
# Elasticsearch endpoint for client connections
ELASTICSEARCH_HOST=https://es01:9200
# Elasticsearch hosts array format for Kibana configuration
ELASTICSEARCH_HOSTS=https://es01:9200
# Discoverery mode for development deployment
ELASTICSEARCH_DISCOVERY_TYPE=single-node
ELASTICSEARCH_SECURITY_ENABLED=true
ELASTICSEARCH_API_KEY_ENABLED=true

# Heap JVM e limiti container
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
ES_MEM_LIMIT=1g

# Some services expect different variable names:
ES_JAVA_OPTS=${ELASTICSEARCH_JAVA_OPTS}

################################################################################
# ACCOUNT DI SICUREZZA ELASTIC
################################################################################
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=m6OHmMuiqNrV1i25Jz3Z

KIBANA_SYSTEM_USERNAME=kibana_system
KIBANA_SYSTEM_PASSWORD=eJL-r*4rNjRioOwWPEMT

KIBANA_UI_USERNAME=kibana_admin
KIBANA_UI_PASSWORD=changeme123

APM_USERNAME=apm_writer
APM_PASSWORD=apm123pass

# Some services expect different variable names:
# 'setup' wants ELASTIC_PASSWORD → linked to ELASTICSEARCH_PASSWORD
ELASTIC_PASSWORD=${ELASTICSEARCH_PASSWORD}
# 'setup' set user passoword for 'kibana_system' as KIBANA_PASSWORD
KIBANA_PASSWORD=${KIBANA_SYSTEM_PASSWORD}

################################################################################
# KIBANA
################################################################################
KIBANA_PORT=5601
KIBANA_URL=http://kibana.localhost
KIBANA_HOST=http://kibana:5601
KIBANA_INDEX_PATTERN=logs-*

# Encryption key for Kibana:
ENCRYPTION_KEY=c34d38b3a14956121ff2170e5030b471551370178f43e5626eec58b04a30fae2
# Reuse of the same key for multiple services:
KIBANA_ENCRYPTION_KEY=${ENCRYPTION_KEY}

# Limite memoria container Kibana usato nella compose
KIBANA_MEM_LIMIT=1g

################################################################################
# APM / RUM
################################################################################
APM_SERVER_PORT=8200
APM_SECRET_TOKEN=apm-secret-token-123
APM_SERVER_URL=http://apm.localhost
APM_SERVER_INTERNAL_URL=http://apm-server:${APM_SERVER_PORT}
APM_KIBANA_HOST=http://kibana:${KIBANA_PORT}

ELASTIC_APM_SERVER_URL=http://apm.localhost
ELASTIC_APM_SERVICE_NAME=go-backend
ELASTIC_APM_ENVIRONMENT=development
ELASTIC_APM_SECRET_TOKEN=${APM_SECRET_TOKEN}

ELASTIC_APM_RUM_SERVER_URL=http://apm.localhost
ELASTIC_APM_RUM_SERVICE_NAME=frontend-app
ELASTIC_APM_RUM_SECRET_TOKEN=rum-secret-token-456

################################################################################
